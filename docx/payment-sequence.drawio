<mxfile host="app.diagrams.net" agent="manual" version="24.0.0">
  <diagram id="seq" name="Payment Sequence">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Payment Flow — Sequence Diagram" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="310" height="30" as="geometry"/>
        </mxCell>

        <!-- Actors -->
        <mxCell id="user_box" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="90" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="app_box" value="Our App :8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="120" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="gw_box" value="Gateway :9000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="60" width="120" height="35" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="user_life" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="125" y="95" as="sourcePoint"/>
            <mxPoint x="125" y="680" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="app_life" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="95" as="sourcePoint"/>
            <mxPoint x="340" y="680" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="gw_life" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="95" as="sourcePoint"/>
            <mxPoint x="570" y="680" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Synchronous section label -->
        <mxCell id="sync_label" value="synchronous" style="text;html=1;fontSize=10;fontColor=#999999;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="sync_bracket" style="endArrow=none;html=1;strokeColor=#CCCCCC;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="145" as="sourcePoint"/>
            <mxPoint x="50" y="370" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 1: User creates order -->
        <mxCell id="s1" value="POST /orders&#xa;{amount: 50}" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="150" as="sourcePoint"/>
            <mxPoint x="335" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 2: Create order with pending status -->
        <mxCell id="s2" value="Create order&#xa;status = pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="165" width="80" height="35" as="geometry"/>
        </mxCell>

        <!-- Step 3: App calls gateway -->
        <mxCell id="s3" value="POST /pay&#xa;{order_id, amount, callback_url, signature}" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="345" y="220" as="sourcePoint"/>
            <mxPoint x="565" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Gateway accepts -->
        <mxCell id="s4" value="200 OK&#xa;{gateway_ref, status: accepted}" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="565" y="255" as="sourcePoint"/>
            <mxPoint x="345" y="255" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 5: Update to processing -->
        <mxCell id="s5" value="Update order&#xa;status = processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="80" height="35" as="geometry"/>
        </mxCell>

        <!-- Step 6: Return to user -->
        <mxCell id="s6" value="200 {order_id, status: processing}" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="325" as="sourcePoint"/>
            <mxPoint x="130" y="325" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Divider -->
        <mxCell id="divider" value="" style="endArrow=none;html=1;strokeColor=#CCCCCC;dashed=1;dashPattern=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="375" as="sourcePoint"/>
            <mxPoint x="680" y="375" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Async section label -->
        <mxCell id="async_label" value="asynchronous" style="text;html=1;fontSize=10;fontColor=#999999;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="385" width="55" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="async_bracket" style="endArrow=none;html=1;strokeColor=#CCCCCC;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="410" as="sourcePoint"/>
            <mxPoint x="50" y="630" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 7: Gateway processes -->
        <mxCell id="s7" value="Processing...&#xa;delay 3s&#xa;random: success/fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="400" width="80" height="50" as="geometry"/>
        </mxCell>

        <!-- Step 8: Webhook callback -->
        <mxCell id="s8" value="POST /webhook/payment&#xa;{order_id, status: completed, hmac_signature}" style="endArrow=classic;html=1;fontSize=10;strokeColor=#D6B656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="565" y="480" as="sourcePoint"/>
            <mxPoint x="345" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Step 9: Verify -->
        <mxCell id="s9" value="Verify HMAC&#xa;signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="495" width="80" height="35" as="geometry"/>
        </mxCell>

        <!-- Step 10: Update order -->
        <mxCell id="s10" value="Update order&#xa;status = completed&#xa;+ credit wallet&#xa;+ ledger entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="295" y="545" width="90" height="55" as="geometry"/>
        </mxCell>

        <!-- Step 11: User sees result -->
        <mxCell id="s11" value="GET /orders → status: completed" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="625" as="sourcePoint"/>
            <mxPoint x="130" y="625" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="s11_label" value="User refreshes page" style="text;html=1;fontSize=10;fontColor=#999999;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="635" width="120" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
